{
  "name": "dotenvmgr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --filter @dotenvmgr/core build && pnpm --filter @dotenvmgr/web dev",
    "dev:web": "pnpm --filter @dotenvmgr/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @dotenvmgr/core build && pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
